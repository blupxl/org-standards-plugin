{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "timeout": 10,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/plan_finished.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/plan_finished.py\" || exit 0" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          { "type": "command", "timeout": 10,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/plan_finished.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/plan_finished.py\" || exit 0" }
        ]
      }
    ]
  }
}
